{
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    // Placeholder only. Production: set env ConnectionStrings__DefaultConnection.
    "DefaultConnection": "Server=localhost;Port=3306;Database=DairyManagement;User=dairy_app;Password=CHANGE_ME;AllowUserVariables=True;"
  },
  "Jwt": {
    "Issuer": "DairyManagement",
    "Audience": "DairyManagementClients",
    // No secret here on purpose: the API refuses to start without one (min 32 chars).
    // Production must set the environment variable Jwt__Secret.
    "Secret": "",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "FileStorage": {
    "BasePath": "uploads"
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*"
}
